<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="tugas lpp coba2"/>
        <attribute name="authors" value="Misael"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-17 10:58:11 AM"/>
        <attribute name="created" value="TWlzYWVsO0xBUFRPUC1PUTRHMlQxUDsyMDI2LTA5LTA3OzEyOjE5OjQ3IFBNOzI5NTI="/>
        <attribute name="edited" value="TWlzYWVsO0xBUFRPUC1PUTRHMlQxUDsyMDI2LTA5LTE3OzEwOjU4OjExIEFNOzQ7MzA0MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="barang1, barang2, barang3" type="String" array="False" size=""/>
            <declare name="harga1, harga2, harga3, jumlah1, jumlah2, jumlah3, totalharga, totalharga2, totalharga3" type="Integer" array="False" size=""/>
            <output expression="&quot;Silahkan masukkan nama barang anda!&quot;" newline="True"/>
            <input variable="barang1"/>
            <input variable="barang2"/>
            <input variable="barang3"/>
            <output expression="&quot;Silahkan masukkan harga barang &quot; &amp; barang1" newline="True"/>
            <input variable="harga1"/>
            <output expression="&quot;Silahkan masukkan harga barang &quot; &amp; barang2" newline="True"/>
            <input variable="harga2"/>
            <output expression="&quot;Silahkan masukkan harga barang &quot; &amp; barang3" newline="True"/>
            <input variable="harga3"/>
            <output expression="&quot;Silahkan masukkan jumlah barang &quot; &amp; barang1" newline="True"/>
            <input variable="Jumlah1"/>
            <output expression="&quot;Silahkan masukkan jumlah barang &quot; &amp; barang2" newline="True"/>
            <input variable="Jumlah2"/>
            <output expression="&quot;Silahkan masukkan jumlah barang &quot; &amp; barang3" newline="True"/>
            <input variable="Jumlah3"/>
            <assign variable="totalharga" expression="harga1*jumlah1 + harga2*jumlah2 + harga3*jumlah3"/>
            <output expression="&quot;Nominal belanja anda sebelum diskon adalah &quot; &amp; totalharga" newline="True"/>
            <if expression="totalharga&lt;50000">
                <then>
                    <output expression="&quot;Anda tidak mendapat diskon&quot;" newline="True"/>
                    <output expression="&quot;Nominal belanja anda adalah &quot; &amp; totalharga" newline="True"/>
                </then>
                <else>
                    <if expression="totalharga&gt;=50000 and totalharga&lt;=99000">
                        <then>
                            <output expression="&quot;Anda mendapat diskon 5%&quot;" newline="True"/>
                            <assign variable="totalharga2" expression="totalharga*0.95"/>
                            <output expression="&quot;Nominal anda setelah diskon adalah &quot; &amp; totalharga2" newline="True"/>
                        </then>
                        <else>
                            <if expression="totalharga&gt;=100000">
                                <then>
                                    <output expression="&quot;Anda mendapat diskon 10%&quot;" newline="True"/>
                                    <assign variable="totalharga3" expression="totalharga*0.90"/>
                                    <output expression="&quot;Nominal belanja anda setelah diskon adalah &quot; &amp; totalharga3" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Error&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
